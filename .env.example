# Copiez ce fichier en .env.local puis remplissez les valeurs.

# --- Démo privée -------------------------------------------------------------
# "true" : bandeau « Démo privée » + site non indexé par Google.
NEXT_PUBLIC_DEMO_MODE=true
# Nom affiché dans le bandeau de démo.
NEXT_PUBLIC_DEMO_AUTHOR="Rawya Belhouchet"
# Si défini, tout le site demande un identifiant / mot de passe (authentification basique).
DEMO_USER=beehive
DEMO_PASSWORD=

# --- URL publique ------------------------------------------------------------
# Utilisée pour le sitemap, les liens de partage et les données structurées.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Espace réservations (/fr/admin) -----------------------------------------
ADMIN_PASSWORD=change-me
# Chaîne aléatoire longue (ex. : openssl rand -base64 32). Facultatif : à défaut,
# elle est dérivée du mot de passe.
ADMIN_SESSION_SECRET=

# --- Stockage des réservations : Supabase (recommandé en production) ----------
# Sans ces deux variables, les réservations sont enregistrées dans .data/reservations.json
# (pratique en local, mais à éviter sur un hébergement serverless).
# Supabase > Settings > API Keys : clé secrète « sb_secret_… » (ou ancienne clé service_role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Notification e-mail à chaque nouvelle demande (Resend) ------------------
RESEND_API_KEY=
RESEND_FROM="Beehive Club <onboarding@resend.dev>"
NOTIFY_EMAIL=

# --- CMS Sanity (carte, soirées, galerie, infos) -----------------------------
# Sans projectId, le site utilise le contenu de src/content/.
SANITY_PROJECT_ID=
SANITY_DATASET=production
